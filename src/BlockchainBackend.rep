class BlockchainBackend
{
    ENUM BlockchainStatus { NotStarted=0, Starting=1, Running=2, Stopping=3, Stopped=4, Error=5 }
    ENUM BlendStatus { Off=0, WaitingForOnline=1, Edge=2, Core=3, Broadcast=4, NodeError=5, BlendError=6, Unknown=7 }

    PROP(BlockchainStatus status READONLY)
    PROP(QString userConfig READWRITE)
    PROP(QString deploymentConfig READWRITE)
    PROP(bool useGeneratedConfig READWRITE)
    PROP(QString generatedUserConfigPath READONLY)
    PROP(QString lastErrorMessage READONLY)
    PROP(QString primaryAddress READONLY)
    // leader.wallet.funding_pk — the key block proposals draw from, where leader
    // rewards land, and which pays a claim's fee. The module assigns it to a
    // DIFFERENT key than primaryAddress (ui#35), so the two must not be conflated.
    PROP(QString leaderKey READONLY)
    PROP(BlendStatus blendStatus READONLY)
    PROP(QString lastBlendEvent READONLY)
    // PREVIEW (#65/#66): the node exposes no resource API yet, so the UI backend
    // samples the blockchain_module process in /proc (Linux). "" when unknown.
    // Remove when the node returns CPU/RAM itself.
    PROP(QString cpuUsage READONLY)
    PROP(QString ramUsage READONLY)

    SLOT(void startBlockchain())
    SLOT(void stopBlockchain())
    SLOT(void confirmRunning())
    SLOT(void confirmStartFailed())
    SLOT(void requestFaucetFunds(QString publicKeyHex))
    SIGNAL(faucetResult(bool ok, QString message))
    SLOT(void refreshAccounts())
    SLOT(QVariantMap getBalance(QString addressHex))
    SLOT(QVariantMap transferFunds(QString fromKeyHex, QString toKeyHex, QString amountStr))
    SLOT(QVariantMap claimLeaderRewards())
    SLOT(QVariantMap getCryptarchiaInfo())
    SLOT(QVariantMap getNetworkInfo())
    SLOT(QVariantMap getRecoveryStatus())
    SLOT(QVariantMap getBlock(QString headerIdHex))
    SLOT(QVariantMap getTransaction(QString txHashHex))
    SLOT(QVariantMap findTransactionInBlocks(QString txHashHex))
    SLOT(QVariantMap getPeerId())
    SLOT(QVariantMap getClaimableVouchers())
    // Persistent leader-claim ledger. Returns {claims:[…], summary:{…}} — the local
    // write-ahead rows reconciled against the chain. See docs/VOUCHER-STATE-MAP.md.
    SLOT(QVariantMap getLeaderClaims())
    // Clear the VISIBLE claims list (#50). Rows move to the store's `archived`
    // array, never deleted: totals, backfill suppression and the alarm's
    // failure counting all look through the archive.
    SLOT(QVariantMap clearLeaderClaims())
    SLOT(QVariantMap getProposals())
    SLOT(QVariantMap generateConfig(QString outputPath, QStringList initialPeers, int netPort, int blendPort, QString httpAddr, QString externalAddress, bool noPublicIpCheck, int deploymentMode, QString deploymentConfigPath, QString statePath))
    SLOT(QVariantMap getNotes(QString walletAddressHex, QString optionalTipHex))
    SLOT(QVariantMap channelDepositWithNotes(QString channelIdHex, QStringList inputNoteIdHexes, QString metadataBase58, QString changePublicKeyHex, QStringList fundingPublicKeyHexes, QString maxTxFee, QString optionalTipHex))
    SLOT(void clearBlocks())
    SLOT(QVariantMap resetChainState())
    // PREVIEW (#81): Settings actions the node has no direct API for, done app-side.
    // backupUserConfig copies the node config (+ keystore) beside itself with a
    // timestamp; regenerateNodeKeys backs up then removes the keystore so the node
    // mints a fresh identity on the next start. Remove when the node offers these.
    SLOT(QVariantMap backupUserConfig())
    SLOT(QVariantMap regenerateNodeKeys())
    SLOT(void copyToClipboard(QString text))
    SLOT(void refreshBlendStatus())
}
